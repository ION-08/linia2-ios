//
// Production .xcconfig
//

// Include Pods config.
#include "Pods/Target Support Files/Pods-Tinodios/Pods-Tinodios.release.xcconfig"

// Server URL
HOST_NAME = v2.chat-linia.site
// Use TLS (https, wss)
USE_TLS = YES

// App Settings
APP_NAME = Линия 2.0

// Versioning. The values are automatically updated by a build script.
GIT_TAG = 1.0.0
GIT_COMMIT_COUNT = 1
